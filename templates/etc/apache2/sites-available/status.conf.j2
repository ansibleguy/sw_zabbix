# {{ ansible_managed }}
# oxlorg.zabbix

<VirtualHost {{ ZABBIX_CNF.apache.status_page.bind }}:{{ ZABBIX_CNF.apache.status_page.port }}>
  # log config
{% if ZABBIX_CNF.apache.log.syslog %}
  ErrorLog "| /usr/bin/logger -p local1.error -t apache2_status"
  CustomLog "| /usr/bin/logger -p local1.info -t apache2_status" combined
{% else %}
  ErrorLog {{ ZABBIX_CNF.apache.log.path }}/error.log
  CustomLog {{ ZABBIX_CNF.apache.log.path }}/access.log combined
{% endif %}

  # status page handling
  <Location "/{{ ZABBIX_CNF.apache.status_page.path }}">
    SetHandler server-status
  </Location>

</VirtualHost>
