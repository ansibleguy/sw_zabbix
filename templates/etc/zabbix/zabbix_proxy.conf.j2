# {{ ansible_managed }}
# oxlorg.zabbix

{% for setting, value in ZABBIX_CNF.proxy.settings.items() %}
{%   if value not in NONE_VALUES and setting not in SETTING_GRAYLIST %}
{{ setting }}={{ value }}
{%   endif %}
{% endfor %}

# tls config
{% if ZABBIX_CNF.proxy.tls_psk not in NONE_VALUES %}
TLSPSKFile={{ ZABBIX_CNF.path_private }}/proxy_psk.txt
{% endif %}

{% if ZABBIX_CNF.proxy.tls_ca_copy not in NONE_VALUES and ZABBIX_CNF.proxy.tls_cert_copy not in NONE_VALUES and ZABBIX_CNF.proxy.tls_key_copy not in NONE_VALUES %}
TLSCAFile={{ ZABBIX_CNF.path_private }}/proxy_ca.crt
TLSCertFile={{ ZABBIX_CNF.path_private }}/proxy_cert.crt
TLSKeyFile={{ ZABBIX_CNF.path_private }}/proxy_cert.key
{% endif %}

{% if ZABBIX_CNF.manage.db | bool %}
# oxlorg.mariadb - db settings
{%   if 'DBUser' not in ZABBIX_CNF.proxy.settings %}
DBUser={{ ZABBIX_CNF.database.user.server_proxy }}
{%   endif %}
{%   if 'DBPassword' not in ZABBIX_CNF.proxy.settings %}
DBPassword={{ ZABBIX_CNF.database.pwd.server_proxy }}
{%   endif %}
{%   if 'DBSocket' not in ZABBIX_CNF.proxy.settings %}
DBSocket={{ ZABBIX_MARIADB_INSTANCE.socket }}
{%   endif %}
{%   if 'DBName' not in ZABBIX_CNF.proxy.settings %}
DBName={{ ZABBIX_CNF.database.name }}
{%   endif %}
{% endif %}
