# {{ ansible_managed }}
# ansibleguy.sw_zabbix

{% for setting, value in ZABBIX_CNF.server.settings.items() %}
{%   if value not in NONE_VALUES and setting not in SETTING_GRAYLIST %}
{{ setting }}={{ value }}
{%   endif %}
{% endfor %}

{% if ZABBIX_CNF.manage.db | bool %}
# ansibleguy.infra_mariadb - db settings
{%   if 'DBUser' not in ZABBIX_CNF.server.settings %}
DBUser={{ ZABBIX_CNF.database.user.server_proxy }}
{%   endif %}
{%   if 'DBPassword' not in ZABBIX_CNF.server.settings %}
DBPassword={{ ZABBIX_CNF.database.pwd.server_proxy }}
{%   endif %}
{%   if 'DBSocket' not in ZABBIX_CNF.server.settings %}
DBSocket={{ ZABBIX_MARIADB_INSTANCE.socket }}
{%   endif %}
{%   if 'DBName' not in ZABBIX_CNF.server.settings %}
DBName={{ ZABBIX_CNF.database.name }}
{%   endif %}
{% endif %}

# tls config
{% if ZABBIX_CNF.server.tls_ca_copy not in NONE_VALUES and ZABBIX_CNF.server.tls_cert_copy not in NONE_VALUES and ZABBIX_CNF.server.tls_key_copy not in NONE_VALUES %}
TLSCAFile={{ ZABBIX_CNF.path_private }}/server_ca.crt
TLSCertFile={{ ZABBIX_CNF.path_private }}/server_cert.crt
TLSKeyFile={{ ZABBIX_CNF.path_private }}/server_cert.key
{% endif %}
